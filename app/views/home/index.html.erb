<div class="min-h-screen from-blue-50 to-white py-10 px-4 mx-auto">
  <div class="max-w-5xl mx-auto">

    <!-- Header -->
    <div class="text-center mb-8">
      <h1 class="text-4xl font-bold text-blue-600">
        Resume <span class="text-gray-800">AI Analyzer</span>
      </h1>
      <p class="text-gray-500 mt-2">
        Upload your resume to get AI-powered analysis & feedback
      </p>
    </div>

    <!-- Upload Card -->
    <div class="bg-white rounded-2xl shadow-md p-6 mb-8">
      <%= form_tag analyze_resume_path, multipart: true, data: { turbo: true } do %>
        <div class="flex flex-col md:flex-row items-center gap-4">
          <!-- File Input (styled as a button via label) -->
          <div class="flex-1 w-full">
            <label class="flex items-center border rounded-lg px-4 py-3 cursor-pointer hover:border-blue-400">
              <%= file_field_tag :resume, accept: ".pdf,.docx", required: true, class: "hidden" %>
              <span class="text-gray-500" id="span_resume">Upload Resume</span>
            </label>
          </div>

          <!-- Submit Button -->
          <div>
            <%= submit_tag "Analyze Resume", class: "bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700" %>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Results Card -->
    <div class="bg-white rounded-2xl shadow-md p-6" id="result">
        <h1 class="font-bold">Result will be displayed here</h1>
    </div>

  </div>
</div>
<script>
  document.addEventListener("DOMContentLoaded", function () {
    const fileInput = document.querySelector('input[type="file"]');
    const fileName = document.getElementById("span_resume");

    fileInput.addEventListener("change", function () {
      if (this.files.length > 0) {
        fileName.textContent = this.files[0].name;
      } else {
        fileName.textContent = "Upload Resume";
      }
    });
  });
</script>
