<div class="max-w-6xl mx-auto px-4 py-8">
  <!-- Header -->
  <div class="text-center mb-10">
    <h1 class="text-4xl font-bold text-gray-900 mb-2">Resume AI Analyzer</h1>
    <p class="text-lg text-gray-600">Upload your resume to get AI‑powered analysis & feedback</p>
  </div>

  <!-- Upload Card -->
  <div class="bg-white rounded-lg shadow-md p-6 mb-10">
    <%= form_tag "#", multipart: true, data: { turbo: true } do %>
      <div class="mb-6">
        <label class="block text-sm font-medium text-gray-700 mb-2">Resume (PDF or DOCX)</label>
        <%= file_field_tag :resume, accept: ".pdf,.docx", required: true,
              class: "block w-full text-sm text-gray-500
                      file:mr-4 file:py-2 file:px-4
                      file:rounded-full file:border-0
                      file:text-sm file:font-semibold
                      file:bg-blue-50 file:text-blue-700
                      hover:file:bg-blue-100" %>
        <p class="mt-1 text-xs text-gray-500">Accepted formats: PDF, DOCX (max 5MB)</p>
      </div>

      <div class="text-center">
        <%= submit_tag "Analyze Resume", class: "bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-6 rounded-md transition duration-200 cursor-pointer" %>
      </div>
    <% end %>
  </div>

  <!-- Results Section (only shown if analysis exists) -->
  <% if @analysis.present? %>
    <div class="bg-white rounded-lg shadow-md overflow-hidden">
      <!-- Results Header -->
      <div class="bg-gradient-to-r from-blue-50 to-indigo-50 px-6 py-4 border-b">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center">
          <h2 class="text-2xl font-semibold text-gray-800">Analysis Results</h2>
          <div class="mt-2 sm:mt-0 flex space-x-2">
            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800">
              <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              Quality: <%= @analysis.score || "High" %>
            </span>
            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-gray-100 text-gray-800">
              <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20"><path d="M4 4a2 2 0 00-2 2v8a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2H4z"/></svg>
              <%= @analysis.filename || "Uploaded Resume" %>
            </span>
          </div>
        </div>
      </div>

      <!-- Three-column grid for Strengths, Weaknesses, Improvements -->
      <div class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-gray-200">
        <!-- Strengths -->
        <div class="p-6">
          <h3 class="text-lg font-semibold text-green-700 mb-3 flex items-center">
            <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
            Strengths
          </h3>
          <ul class="space-y-2 text-gray-700">
            <% @analysis.strengths.each do |strength| %>
              <li class="flex items-start">
                <span class="text-green-500 mr-2">✓</span>
                <span><%= strength %></span>
              </li>
            <% end %>
          </ul>
        </div>

        <!-- Weaknesses -->
        <div class="p-6">
          <h3 class="text-lg font-semibold text-red-700 mb-3 flex items-center">
            <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/></svg>
            Weaknesses
          </h3>
          <ul class="space-y-2 text-gray-700">
            <% @analysis.weaknesses.each do |weakness| %>
              <li class="flex items-start">
                <span class="text-red-500 mr-2">✗</span>
                <span><%= weakness %></span>
              </li>
            <% end %>
          </ul>
        </div>

        <!-- Improvements -->
        <div class="p-6">
          <h3 class="text-lg font-semibold text-blue-700 mb-3 flex items-center">
            <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
            Improvements
          </h3>
          <ul class="space-y-2 text-gray-700">
            <% @analysis.improvements.each do |improvement| %>
              <li class="flex items-start">
                <span class="text-blue-500 mr-2">→</span>
                <span><%= improvement %></span>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  <% else %>
    <!-- Placeholder when no analysis yet -->
    <div class="bg-gray-50 rounded-lg p-8 text-center text-gray-500">
      <svg class="mx-auto h-12 w-12 text-gray-400 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
      <p class="text-lg">Upload a resume to see the analysis.</p>
    </div>
  <% end %>
</div>