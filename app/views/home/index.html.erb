<div class="min-h-screen from-blue-50 to-white py-10 px-4 mx-auto">
  <div class="max-w-5xl mx-auto">

    <!-- Header -->
    <div class="text-center mb-8">
      <h1 class="text-4xl font-bold text-blue-600">
        Resume <span class="text-gray-800">AI Analyzer</span>
      </h1>
      <p class="text-gray-500 mt-2">
        Upload your resume to get AI-powered analysis & feedback
      </p>
    </div>

    <!-- Upload Card -->
    <div class="bg-white rounded-2xl shadow-md p-6 mb-8">
      <div class="flex flex-col md:flex-row items-center gap-4">
        
        <!-- File Input -->
        <div class="flex-1 w-full">
          <label class="flex items-center border rounded-lg px-4 py-3 cursor-pointer hover:border-blue-400">
            <input type="file" class="hidden" />
            <span class="text-gray-500">Upload Resume</span>
          </label>
        </div>

        <!-- Button -->
        <div>
          <button class="bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700">
            Analyze Resume
          </button>
        </div>
      </div>
    </div>

    <!-- Results Card -->
    <div class="bg-white rounded-2xl shadow-md p-6">
      <h2 class="text-lg font-semibold text-gray-700 mb-6">Analysis Results</h2>

      <div class="grid grid-cols-1 md:grid-cols-4 gap-6">

        <!-- Score -->
        <div class="flex flex-col items-center justify-center">
          <div class="relative">
            <svg class="w-28 h-28">
              <circle cx="56" cy="56" r="50" stroke="#e5e7eb" stroke-width="10" fill="none" />
              <circle cx="56" cy="56" r="50" stroke="#22c55e" stroke-width="10" fill="none"
                stroke-dasharray="314"
                stroke-dashoffset="47"
                stroke-linecap="round" />
            </svg>
            <div class="absolute inset-0 flex items-center justify-center">
              <span class="text-xl font-bold text-green-500">85%</span>
            </div>
          </div>
        </div>

        <!-- Strengths -->
        <div>
          <h3 class="font-semibold text-gray-800 mb-2">Strengths</h3>
          <ul class="space-y-2 text-sm text-gray-600">
            <li class="flex items-center gap-2">
              <span class="text-green-500">✔</span> Good project management
            </li>
            <li class="flex items-center gap-2">
              <span class="text-green-500">✔</span> Strong communication
            </li>
            <li class="flex items-center gap-2">
              <span class="text-green-500">✔</span> Well-structured resume
            </li>
          </ul>
        </div>

        <!-- Weakness -->
        <div>
          <h3 class="font-semibold text-gray-800 mb-2">Weakness</h3>
          <ul class="space-y-2 text-sm text-gray-600">
            <li class="flex items-center gap-2">
              <span class="text-red-500">✖</span> Lacks key technical skills
            </li>
            <li class="flex items-center gap-2">
              <span class="text-red-500">✖</span> Missing achievements
            </li>
            <li class="flex items-center gap-2">
              <span class="text-red-500">✖</span> Weak skills section
            </li>
          </ul>
        </div>

        <!-- Improvements -->
        <div>
          <h3 class="font-semibold text-gray-800 mb-2">Improvements</h3>
          <ul class="space-y-2 text-sm text-gray-600">
            <li class="flex items-center gap-2">
              <span class="text-yellow-500">⚠</span> Add measurable results
            </li>
            <li class="flex items-center gap-2">
              <span class="text-yellow-500">⚠</span> Improve keywords for ATS
            </li>
            <li class="flex items-center gap-2">
              <span class="text-yellow-500">⚠</span> Optimize formatting
            </li>
          </ul>
        </div>

      </div>
    </div>

  </div>
</div>
