<h2 class="text-lg font-semibold text-gray-700 mb-6">Analysis Results</h2>
<% if analysis.present? && analysis[:error].present? %>
<div>
    <h1 class="text-red-500"><%= analysis[:error] %></h1>
</div>
<% else %>
<div class="grid grid-cols-1 md:grid-cols-4 gap-6">
    <% offset = 314 - (314 * analysis['ats_score'] / 100)  %>
    <!-- Score -->
    <div class="flex flex-col items-center justify-center">
        <div class="relative">
        <svg class="w-28 h-28">
            <circle cx="56" cy="56" r="50" stroke="#e5e7eb" stroke-width="10" fill="none" />
            <circle cx="56" cy="56" r="50" stroke="#22c55e" stroke-width="10" fill="none"
            stroke-dasharray="314"
            stroke-dashoffset="<%= offset %>"
            stroke-linecap="round" />
        </svg>
        <div class="absolute inset-0 flex items-center justify-center">
            <span class="text-xl font-bold text-green-500"><%= analysis['ats_score'] %>%</span>
        </div>
        </div>
    </div>

    <!-- Strengths -->
    <div>
        <h3 class="font-semibold text-gray-800 mb-2">Strengths</h3>
        <ul class="space-y-2 text-sm text-gray-600">
            <% analysis["strengths"].each do |strength| %>
                <li class="flex items-center gap-2">
                    <span class="text-green-500">✔</span> <%= strength %>
                </li>
            <% end %>
        </ul>
    </div>

    <!-- Weakness -->
    <div>
        <h3 class="font-semibold text-gray-800 mb-2">Weakness</h3>
        <ul class="space-y-2 text-sm text-gray-600">
            <% analysis['weaknesses'].each do |weakness| %>
                <li class="flex items-center gap-2">
                    <span class="text-red-500">✖</span> <%= weakness %>
                </li>
            <% end %>
        </ul>
    </div>

    <!-- Improvements -->
    <div>
        <h3 class="font-semibold text-gray-800 mb-2">Improvements</h3>
        <ul class="space-y-2 text-sm text-gray-600">
            <% analysis['improvements'].each do |improvement| %>
                <li class="flex items-center gap-2">
                    <span class="text-yellow-500">⚠</span> <%= improvement %>
                </li>
            <% end %>
        </ul>
    </div>

</div>
<% end %>
